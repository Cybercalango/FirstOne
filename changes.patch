+  reason TEXT NOT NULL DEFAULT 'outro',
+  reference TEXT DEFAULT '', notes TEXT DEFAULT '', created_at TIMESTAMPTZ DEFAULT now());`);
+  await db.exec(mig);
+  return db;
+}
+
+let db = await setup();
+await db.exec(`CREATE TABLE dbg(step TEXT, info TEXT)`);

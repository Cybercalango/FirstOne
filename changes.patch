+--- Corrige "null value in column \"name\" of relation \"items\""
++-- =====================================================================
++-- 21_fix_items_name_not_null.sql
++-- Corrige o erro: "null value in column \"name\" of relation \"items\"
++--  violates not-null constraint" ao cadastrar peças (Produtos).
++--
++-- Causa raiz (reproduzida em teste local — ver tests/test_items.mjs):
++-- quando a tabela `items` do projeto foi criada a partir da tabela
++-- legada `products` (o script 10_verificar_e_corrigir_tudo.sql faz
++-- `ALTER TABLE products RENAME TO items`), ela herda a coluna
++-- `name TEXT NOT NULL`. O INSERT do app não envia `name`, então o
++-- Postgres rejeita o cadastro. Os scripts 15/18 usam
++-- `ADD COLUMN IF NOT EXISTS`, que NÃO adiciona a restrição — mas
++-- também nunca REMOVE o NOT NULL herdado da tabela antiga.
++--
++-- Correção em duas frentes:
++--   1) Banco (este script): remove o NOT NULL de `items.name`,
++--      preenche nomes antigos e cria um trigger que gera o nome
++--      automaticamente (nome do modelo > código de barras > id).
++--   2) App (src/pages/Produtos.jsx): passa a enviar `name` no
++--      insert, com validação de nome/código antes de salvar.
++-- Idempotente: pode rodar quantas vezes quiser.
++-- =====================================================================
++
++-- 1) Garante que a coluna name existe (para bancos criados só pelos
++--    scripts 02/09/15/18, que não a têm) e que é NULLABLE.
+ ALTER TABLE public.items ADD COLUMN IF NOT EXISTS name TEXT;
+ ALTER TABLE public.items ALTER COLUMN name DROP NOT NULL;
+ 
++-- 2) Preenche o nome das peças já cadastradas que estão sem nome.
+ UPDATE public.items
+ SET name = COALESCE(
+       (SELECT m.name FROM public.models m WHERE m.id = items.model_id),
+@@ -10,6 +35,9 @@ SET name = COALESCE(
+     )
+ WHERE name IS NULL OR btrim(name) = '';
+ 
++-- 3) Trigger: se um INSERT chegar sem `name` (ex.: versão antiga do
++--    app ou outra integração), o banco preenche sozinho — o cadastro
++--    nunca mais falha por causa disso.
+ CREATE OR REPLACE FUNCTION public.items_set_name()
+ RETURNS trigger LANGUAGE plpgsql AS $$
+ BEGIN
+@@ -31,8 +59,10 @@ CREATE TRIGGER trg_items_set_name
+ BEFORE INSERT ON public.items
+ FOR EACH ROW EXECUTE FUNCTION public.items_set_name();
+ 
++-- 4) Limpa o cache de schema do PostgREST.
+ NOTIFY pgrst, 'reload schema';
+ 
+--- Conferência: deve retornar name | YES
+-SELECT column_name, is_nullable FROM information_schema.columns
++-- 5) Conferência: `name` deve aparecer com is_nullable = 'YES'.
++SELECT column_name, is_nullable
++FROM information_schema.columns
+ WHERE table_schema='public' AND table_name='items' AND column_name='name';
+diff --git a/sql/22_fix_stock_movements_columns.sql b/sql/22_fix_stock_movements_columns.sql
+index e99b9df..4440f66 100644
+--- a/sql/22_fix_stock_movements_columns.sql
++++ b/sql/22_fix_stock_movements_columns.sql
+@@ -1,22 +1,106 @@
+--- Corrige "Could not find the 'quantity' column of 'stock_movements'"
++-- =====================================================================
++-- 22_fix_stock_movements_columns.sql
++-- Corrige o erro ao registrar movimentação de estoque:
++--   "Could not find the 'quantity' column of 'stock_movements' in the
++--    schema cache"
++--
++-- Causa raiz (reproduzida em teste local — ver tests/test_stock_movements.mjs):
++-- o app (src/pages/Movimentacoes.jsx) insere e lê as colunas
++-- `type` e `quantity`, mas as migrações 07/08/09/10 criaram a tabela
++-- stock_movements com `movement_type` e SEM `quantity`. O PostgREST,
++-- ao receber uma coluna inexistente, devolve exatamente esta mensagem
++-- de "schema cache".
++--
++-- Correção em duas frentes:
++--   1) Banco (este script): adiciona `type` e `quantity` à tabela
++--      (mantendo `movement_type` por compatibilidade e sincronizando
++--      as duas via trigger), mais NOTIFY pgrst para limpar o cache.
++--   2) App (Movimentacoes.jsx): leitura do histórico passa a usar
++--      m.type (nome real da coluna).
++-- Idempotente: pode rodar quantas vezes quiser.
++-- =====================================================================
++
++-- 1) Colunas novas: type (espelho de movement_type) e quantity.
+ ALTER TABLE public.stock_movements ADD COLUMN IF NOT EXISTS type TEXT;
+-ALTER TABLE public.stock_movements ADD COLUMN IF NOT EXISTS quantity INTEGER NOT NULL DEFAULT 1;
+-ALTER TABLE public.stock_movements ADD COLUMN IF NOT EXISTS movement_type TEXT; -- legado
++ALTER TABLE public.stock_movements ADD COLUMN IF NOT EXISTS quantity INT NOT NULL DEFAULT 1;
++
++DO $$
++BEGIN
++  IF NOT EXISTS (SELECT 1 FROM pg_constraint
++                 WHERE conname = 'stock_movements_quantity_check'
++                   AND conrelid = 'public.stock_movements'::regclass) THEN
++    ALTER TABLE public.stock_movements
++      ADD CONSTRAINT stock_movements_quantity_check CHECK (quantity > 0);
++  END IF;
++END $$;
+ 
+--- Sincroniza type <-> movement_type
+-UPDATE public.stock_movements SET type = movement_type WHERE type IS NULL AND movement_type IS NOT NULL;
+-UPDATE public.stock_movements SET movement_type = type WHERE movement_type IS NULL AND type IS NOT NULL;
++-- 2) Preenche `type` a partir de `movement_type` nas linhas existentes.
++UPDATE public.stock_movements
++SET type = COALESCE(movement_type, 'saida')
++WHERE type IS NULL OR btrim(type) = '';
+ 
+-CREATE OR REPLACE FUNCTION public.stock_movements_sync_type() RETURNS trigger LANGUAGE plpgsql AS $$
++-- 3) Trigger BEFORE INSERT: mantém type/movement_type sincronizados e
++--    garante quantity >= 1. Funciona tanto para o app novo (envia type)
++--    quanto para qualquer versão antiga (envia movement_type).
++CREATE OR REPLACE FUNCTION public.stock_movements_sync_type()
++RETURNS trigger LANGUAGE plpgsql AS $$
++DECLARE has_legacy BOOLEAN;
+ BEGIN
+-  IF NEW.type IS NULL AND NEW.movement_type IS NOT NULL THEN NEW.type := NEW.movement_type; END IF;
+-  IF NEW.movement_type IS NULL AND NEW.type IS NOT NULL THEN NEW.movement_type := NEW.type; END IF;
++  SELECT EXISTS (SELECT 1 FROM information_schema.columns
++                 WHERE table_schema='public' AND table_name='stock_movements'
++                   AND column_name='movement_type')
++    INTO has_legacy;
++
++  IF NEW.type IS NOT NULL AND btrim(NEW.type) <> '' THEN
++    IF has_legacy THEN NEW.movement_type := NEW.type; END IF;   -- espelha no legado
++  ELSIF has_legacy AND NEW.movement_type IS NOT NULL THEN
++    NEW.type := NEW.movement_type;                               -- versão antiga do app
++  ELSE
++    NEW.type := 'saida';
++    IF has_legacy THEN NEW.movement_type := 'saida'; END IF;
++  END IF;
++
++  IF NEW.quantity IS NULL OR NEW.quantity < 1 THEN
++    NEW.quantity := 1;
++  END IF;
+   RETURN NEW;
+ END $$;
+ 
+-DROP TRIGGER IF EXISTS trg_stock_movements_sync ON public.stock_movements;
+-CREATE TRIGGER trg_stock_movements_sync
+-BEFORE INSERT OR UPDATE ON public.stock_movements
++DROP TRIGGER IF EXISTS trg_stock_movements_sync_type ON public.stock_movements;
++CREATE TRIGGER trg_stock_movements_sync_type
++BEFORE INSERT ON public.stock_movements
+ FOR EACH ROW EXECUTE FUNCTION public.stock_movements_sync_type();
+ 
++-- 4) Gatilho que aplica o movimento ao status da peça passa a aceitar
++--    ambos os nomes de coluna (type ou movement_type) e o status
++--    'emprestado' usado pelo app nas saídas (empréstimo a parceiros).
++CREATE OR REPLACE FUNCTION public.apply_stock_movement()
++RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
++DECLARE v_from TEXT; v_tipo TEXT; v_status TEXT;
++BEGIN
++  v_tipo := COALESCE(NULLIF(btrim(COALESCE(NEW.type,'')), ''), NEW.movement_type, 'saida');
++  v_status := CASE WHEN v_tipo = 'saida' THEN 'emprestado' ELSE 'estoque' END;
++  BEGIN
++    SELECT status INTO v_from FROM public.items WHERE id = NEW.item_id FOR UPDATE;
++    UPDATE public.items SET status = v_status WHERE id = NEW.item_id;
++    INSERT INTO public.item_status_history (item_id, from_status, to_status, reason, user_id)
++    VALUES (NEW.item_id, v_from, v_status, COALESCE(NULLIF(NEW.reason,''), v_tipo), NEW.user_id);
++  EXCEPTION WHEN undefined_table OR undefined_column THEN
++    NULL; -- segue registrando a movimentação mesmo se a base estiver incompleta
++  END;
++  RETURN NEW;
++END $$;
++
++DROP TRIGGER IF EXISTS trg_apply_stock_movement ON public.stock_movements;
++CREATE TRIGGER trg_apply_stock_movement
++AFTER INSERT ON public.stock_movements
++FOR EACH ROW EXECUTE FUNCTION public.apply_stock_movement();
++
++-- 5) Limpa o cache de schema do PostgREST (resolve o "in the schema cache").
+ NOTIFY pgrst, 'reload schema';
++
++-- 6) Conferência: deve listar type e quantity entre as colunas.
++SELECT column_name, is_nullable, column_default
++FROM information_schema.columns
++WHERE table_schema='public' AND table_name='stock_movements'
++ORDER BY ordinal_position;
+diff --git a/sql/23_estoque_quantidade_no_cadastro.sql b/sql/23_estoque_quantidade_no_cadastro.sql
+index eb6dfbd..e44e206 100644
+--- a/sql/23_estoque_quantidade_no_cadastro.sql
++++ b/sql/23_estoque_quantidade_no_cadastro.sql
+@@ -1,15 +1,126 @@
+--- Cadastro com quantidade: aceita reason 'cadastro', reassegura colunas e corrige FK de histórico
++-- =====================================================================
++-- 23_estoque_quantidade_no_cadastro.sql
++-- Permite informar QUANTIDADE ao cadastrar peças (Produtos).
++--
++-- Contexto: o cadastro de itens é a primeira entrada de estoque de um
++-- produto novo. O app passará a inserir N peças iguais e registrar N
++-- movimentações do tipo 'entrada'. Para isso faltavam no banco:
++--   1) `quantity` em stock_movements já vem da migração 22 (re-assegurada
++--      aqui de forma idempotente);
++--   2) CHECK de `reason` não incluía 'cadastro' — este script adiciona;
++--   3) A trigger apply_stock_movement() forçava 'estoque'/'emprestado'
++--      em todo movimento, o que conflitaria com status iniciais
++--      'consignacao' escolhidos no cadastro — a trigger passa a respeitar
++--      movimentos de entrada quando o item já tem status válido próprio.
++-- Idempotente: pode rodar quantas vezes quiser.
++-- =====================================================================
++
++-- 1) Re-assegura quantity (idempotente, caso o 22 ainda não tenha rodado).
+ ALTER TABLE public.stock_movements ADD COLUMN IF NOT EXISTS type TEXT;
+-ALTER TABLE public.stock_movements ADD COLUMN IF NOT EXISTS quantity INTEGER NOT NULL DEFAULT 1;
++ALTER TABLE public.stock_movements ADD COLUMN IF NOT EXISTS quantity INT NOT NULL DEFAULT 1;
++
++DO $$
++BEGIN
++  IF NOT EXISTS (SELECT 1 FROM pg_constraint
++                 WHERE conname = 'stock_movements_quantity_check'
++                   AND conrelid = 'public.stock_movements'::regclass) THEN
++    ALTER TABLE public.stock_movements
++      ADD CONSTRAINT stock_movements_quantity_check CHECK (quantity > 0);
++  END IF;
++END $$;
++
++UPDATE public.stock_movements
++SET type = COALESCE(movement_type, 'saida')
++WHERE type IS NULL OR btrim(type) = '';
++
++-- 2) Amplia o CHECK de reason para aceitar 'cadastro' (e 'producao', que
++--    também é usada por compras/produção). Remove o antigo e recria.
++DO $$
++DECLARE c TEXT;
++BEGIN
++  SELECT conname INTO c FROM pg_constraint
++   WHERE conrelid = 'public.stock_movements'::regclass
++     AND contype = 'c'
++     AND pg_get_constraintdef(oid) LIKE '%reason%'
++   LIMIT 1;
++  IF c IS NOT NULL THEN
++    EXECUTE format('ALTER TABLE public.stock_movements DROP CONSTRAINT %I', c);
++  END IF;
++END $$;
++
++ALTER TABLE public.stock_movements
++  ADD CONSTRAINT stock_movements_reason_check CHECK (
++    reason IN ('compra','producao','ajuste','venda','consignacao',
++               'devolucao_consignacao','quebra','perda','transferencia',
++               'cadastro','outro'));
+ 
+--- Motivos aceitos (inclui 'cadastro')
+-DO $$ BEGIN
+-  ALTER TABLE public.stock_movements DROP CONSTRAINT IF EXISTS stock_movements_reason_check;
+-EXCEPTION WHEN others THEN NULL; END $$;
++-- 3) Trigger que aplica o movimento ao status da peça:
++--    - saida  -> 'emprestado'
++--    - entrada-> 'estoque', MAS respeita o status inicial escolhido no
++--      cadastro (ex.: consignacao), evitando sobrescrever o formulário.
++CREATE OR REPLACE FUNCTION public.apply_stock_movement()
++RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$
++DECLARE v_from TEXT; v_tipo TEXT; v_status TEXT;
++BEGIN
++  v_tipo := COALESCE(NULLIF(btrim(COALESCE(NEW.type,'')), ''), NEW.movement_type, 'saida');
++  BEGIN
++    SELECT status INTO v_from FROM public.items WHERE id = NEW.item_id FOR UPDATE;
++    IF v_tipo = 'saida' THEN
++      v_status := 'emprestado';
++    ELSE
++      -- entrada: mantém o status atual se ele já for coerente com posse
++      -- da loja (estoque/consignacao); caso contrário devolve ao estoque.
++      v_status := CASE WHEN v_from IN ('estoque','consignacao') THEN v_from ELSE 'estoque' END;
++    END IF;
++    UPDATE public.items SET status = v_status WHERE id = NEW.item_id;
++    INSERT INTO public.item_status_history (item_id, from_status, to_status, reason, user_id)
++    VALUES (NEW.item_id, v_from, v_status, COALESCE(NULLIF(NEW.reason,''), v_tipo), NEW.user_id);
++  EXCEPTION WHEN undefined_table OR undefined_column THEN
++    NULL; -- segue registrando a movimentação mesmo se a base estiver incompleta
++  END;
++  RETURN NEW;
++END $$;
+ 
+--- item_status_history.item_id precisa ser BIGINT quando items.id for BIGINT (evita 22003 out of range)
+-DO $$ BEGIN
+-  ALTER TABLE public.item_status_history ALTER COLUMN item_id TYPE BIGINT;
+-EXCEPTION WHEN others THEN NULL; END $$;
++DROP TRIGGER IF EXISTS trg_apply_stock_movement ON public.stock_movements;
++CREATE TRIGGER trg_apply_stock_movement
++AFTER INSERT ON public.stock_movements
++FOR EACH ROW EXECUTE FUNCTION public.apply_stock_movement();
+ 
++-- 4) Trigger BEFORE INSERT reforçada (versão do app novo): além de
++--    sincronizar type/movement_type, aplica um GATE de quantidade —
++--    quantity NULL ou < 1 vira 1 automaticamente. Assim o cadastro em
++--    lote nunca grava movimento com quantidade inválida.
++CREATE OR REPLACE FUNCTION public.stock_movements_sync_type()
++RETURNS trigger LANGUAGE plpgsql AS $$
++DECLARE has_legacy BOOLEAN;
